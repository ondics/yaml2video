{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/yaml2video/v2/video.schema.json",
  "title": "yaml2video v2 video document",
  "description": "A renderer-independent, content-focused video document. YAML files are validated against this JSON Schema after parsing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "template", "metadata", "content"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema reference used by schema-aware editors."
    },
    "version": {
      "const": 2,
      "description": "The major version of the public video document format."
    },
    "template": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the template that supplies layout and rendering defaults."
    },
    "metadata": {"$ref": "#/$defs/metadata"},
    "assets": {"$ref": "#/$defs/assets"},
    "content": {"$ref": "#/$defs/content"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable title of the video."
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$",
          "description": "Primary language of visible and spoken content, for example de-DE."
        },
        "audience": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "target_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Optional target duration. The renderer reports the effective duration after composition."
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logo": {
          "$ref": "#/$defs/path",
          "description": "Optional logo used by the selected template."
        },
        "music": {
          "$ref": "#/$defs/audio_track",
          "description": "Optional background music asset for the rendered video."
        }
      }
    },
    "audio_track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Optional content-level override for the template's music volume."
        },
        "fade_in": {"$ref": "#/$defs/duration"},
        "fade_out": {"$ref": "#/$defs/duration"}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slides"],
      "properties": {
        "intro": {"$ref": "#/$defs/intro"},
        "slides": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/slide"},
          "description": "Ordered content items repeated by the template's slide section."
        },
        "outro": {"$ref": "#/$defs/outro"}
      }
    },
    "intro": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {"$ref": "#/$defs/path"},
        "title": {"$ref": "#/$defs/nonEmptyText"},
        "subtitle": {"$ref": "#/$defs/nonEmptyText"},
        "duration": {"$ref": "#/$defs/duration"},
        "audio": {"$ref": "#/$defs/audio_track"},
        "sound_effects": {"$ref": "#/$defs/sound_effects"}
      },
      "anyOf": [{"required": ["title"]}, {"required": ["image"]}]
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "image": {"$ref": "#/$defs/path"},
        "text": {
          "$ref": "#/$defs/nonEmptyText",
          "description": "Primary visible message for the image."
        },
        "tip": {
          "$ref": "#/$defs/nonEmptyText",
          "description": "Optional practical tip or instruction."
        },
        "label": {
          "$ref": "#/$defs/nonEmptyText",
          "description": "Optional short label, for example SHOULDERS or 30 SECONDS."
        },
        "alt_text": {
          "$ref": "#/$defs/nonEmptyText",
          "description": "Accessible description of the image."
        },
        "duration": {"$ref": "#/$defs/duration"},
        "audio": {"$ref": "#/$defs/audio_track", "description": "Foreground audio played during this slide."},
        "sound_effects": {"$ref": "#/$defs/sound_effects", "description": "Effects positioned relative to the start of this slide."}
      }
    },
    "outro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cta"],
      "properties": {
        "image": {"$ref": "#/$defs/path"},
        "title": {"$ref": "#/$defs/nonEmptyText"},
        "text": {"$ref": "#/$defs/nonEmptyText"},
        "cta": {
          "$ref": "#/$defs/nonEmptyText",
          "description": "Call-to-action text."
        },
        "duration": {"$ref": "#/$defs/duration"},
        "audio": {"$ref": "#/$defs/audio_track"},
        "sound_effects": {"$ref": "#/$defs/sound_effects"}
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "A local path or a renderer-supported URI."
    },
    "nonEmptyText": {"type": "string", "minLength": 1},
    "duration": {
      "description": "Positive duration in seconds as a number or as a string ending in s, for example 3 or 3.5s.",
      "oneOf": [
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?s$"}
      ]
    },
    "sound_effects": {
      "type": "array",
      "items": {"$ref": "#/$defs/sound_effect"}
    },
    "sound_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "at"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "at": {"$ref": "#/$defs/time_offset", "description": "Start time relative to the containing section."},
        "volume": {"type": "number", "minimum": 0, "maximum": 1},
        "fade_in": {"$ref": "#/$defs/duration"},
        "fade_out": {"$ref": "#/$defs/duration"}
      }
    },
    "time_offset": {
      "description": "Non-negative offset in seconds as a number or as a string ending in s.",
      "oneOf": [
        {"type": "number", "minimum": 0},
        {"type": "string", "pattern": "^(?:0|[0-9]+(?:\\.[0-9]+)?)s$"}
      ]
    }
  }
}
